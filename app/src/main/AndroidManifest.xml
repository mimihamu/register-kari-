<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RegisterApplication"
        android:allowBackup="false"
        android:label="REGISTER（仮）"
        android:supportsRtl="true"
        android:theme="@style/Theme.Register">

        <activity
            android:name=".AdvancedOperationsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!--
          MainActivityは従来どおりOperationsActivityを明示起動する。
          v0.6ではactivity-aliasで統合業務画面へ安全に差し替える。
        -->
        <activity-alias
            android:name=".OperationsActivity"
            android:exported="false"
            android:targetActivity=".AdvancedOperationsActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
