<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RegisterApplication"
        android:allowBackup="false"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Register"
        android:usesCleartextTraffic="true">

        <provider
            android:name=".CatalogBootstrapProvider"
            android:authorities="${applicationId}.catalog-bootstrap"
            android:exported="false"
            android:initOrder="100" />

        <provider
            android:name=".JournalOutboxBootstrapProvider"
            android:authorities="${applicationId}.journal-outbox-bootstrap"
            android:exported="false"
            android:initOrder="110" />

        <provider
            android:name=".DocumentPrintSafetyBootstrapProvider"
            android:authorities="${applicationId}.document-print-safety-bootstrap"
            android:exported="false"
            android:initOrder="120" />

        <provider
            android:name=".PrintQueueRecoveryBootstrapProvider"
            android:authorities="${applicationId}.print-queue-recovery-bootstrap"
            android:exported="false"
            android:initOrder="130" />

        <provider
            android:name=".PrinterToolsAdminOverlayProvider"
            android:authorities="${applicationId}.printer-tools-admin-overlay"
            android:exported="false"
            android:initOrder="140" />

        <activity
            android:name=".MenuRevisionEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SyncSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".DynamicCatalogSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".CatalogSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AdminSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AdvancedOperationsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PrinterStatusActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PrinterNotificationSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PrinterSoakTestActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PrinterToolsHubActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".UnifiedPrintQueueActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity-alias
            android:name=".OperationsActivity"
            android:exported="false"
            android:targetActivity=".AdvancedOperationsActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
