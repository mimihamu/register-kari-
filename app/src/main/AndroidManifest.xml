<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RegisterApplication"
        android:allowBackup="false"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Register"
        android:usesCleartextTraffic="true">

        <provider
            android:name=".CatalogBootstrapProvider"
            android:authorities="${applicationId}.catalog-bootstrap"
            android:exported="false"
            android:initOrder="100" />

        <provider
            android:name=".JournalOutboxBootstrapProvider"
            android:authorities="${applicationId}.journal-outbox-bootstrap"
            android:exported="false"
            android:initOrder="110" />

        <activity
            android:name=".MenuRevisionEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SyncSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".DynamicCatalogSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".CatalogSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AdminSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AdvancedOperationsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!--
          MainActivityは従来どおりOperationsActivityを明示起動する。
          activity-aliasで統合業務画面へ安全に差し替える。
        -->
        <activity-alias
            android:name=".OperationsActivity"
            android:exported="false"
            android:targetActivity=".AdvancedOperationsActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
