<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PlusApplicationV138"
        android:allowBackup="false"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.TsuguRegiPlus">

        <provider
            android:name=".GoogleDrivePageCommitRecoveryProviderV134"
            android:authorities="${applicationId}.google-drive-page-commit-recovery-v134"
            android:exported="false"
            android:initOrder="400" />

        <provider
            android:name=".GoogleDriveOrphanedRunRecoveryProviderV131"
            android:authorities="${applicationId}.google-drive-orphaned-run-recovery-v131"
            android:exported="false"
            android:initOrder="300" />

        <provider
            android:name=".GoogleDriveVerificationHistoryRecoveryProviderV130"
            android:authorities="${applicationId}.google-drive-verification-history-recovery-v130"
            android:exported="false"
            android:initOrder="200" />

        <provider
            android:name=".GoogleDriveDirectSyncBootstrapProvider"
            android:authorities="${applicationId}.google-drive-direct-sync-bootstrap"
            android:exported="false"
            android:initOrder="100" />

        <activity
            android:name=".GoogleDriveSetupGuideActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".GoogleDriveDiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".GoogleDriveSyncVerificationActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".GoogleDriveRecoveryActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".GoogleDriveEasyConnectActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".GoogleDriveAccountActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".TaxCategoryMasterActivityV135"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorPortrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
